# SQLite is the local default. Use postgresql+psycopg://... for deployment.
DATABASE_URL=sqlite:///./cloudpilot.db
# Used by optional, read-only topology and CloudWatch calls.
AWS_REGION=eu-north-1
# AWS_PROFILE=cloudpilot-readonly
# Cost Explorer reports account/service-period cost only; it does not attribute
# an individual Terraform resource. The default endpoint is us-east-1.
# AWS_COST_EXPLORER_REGION=us-east-1
# Production never seeds example teams, policies, or resource mappings.
# APP_ENV=production
# SEED_DEMO_DATA=false
# Optional comma-separated browser origins for a separately hosted frontend.
# CORS_ORIGINS=https://cloudpilot.example.edu
